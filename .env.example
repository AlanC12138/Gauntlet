# Required: the Allocation Agent calls Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# GAUNTLET_MODEL=claude-opus-5
# GAUNTLET_RISK_FREE_RATE=0.0

# Services. These defaults match docker-compose.yml, which uses non-default
# ports so it cannot collide with a Postgres or Redis already on the machine.
# Alembic reads the URL from here too — do not add one to alembic.ini.
# GAUNTLET_DATABASE_URL=postgresql+psycopg://gauntlet:gauntlet@localhost:5433/gauntlet
# GAUNTLET_REDIS_URL=redis://localhost:6380/0

# Clerk (Phase 5). Leave unset to run with auth disabled — every route public,
# which is how the demo and local development are meant to work.
# This is the SECRET key (sk_test_... / sk_live_...). It must never reach the
# browser or a git commit. The publishable key is a separate value and lives in
# frontend/.env.local instead.
# CLERK_SECRET_KEY=sk_test_...
