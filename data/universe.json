  "schema_version": "1.0",
  "universe_id": "gauntlet-demo-v1",
  "description": "Fixed demo universe for Gauntlet: 39 liquid US large-cap equities spanning all 11 GICS sectors, plus 8 ETFs (3 broad equity, 2 sector, 2 fixed income, 1 commodity). Sized so that diversification and sector-cap constraints actually bind rather than being trivially satisfiable.",
  "backtest_window": {
    "start": "2013-01-01",
    "end": "2025-12-31",
    "rationale": "Earliest date at which every constituent has continuous price history (binding constraint: META, IPO 2012-05-18). Fixed end date rather than 'today' so backtest results stay reproducible across runs."
  },
  "sector_taxonomy": {
    "standard": "GICS",
    "level": "sector",
    "point_in_time": false,
    "as_of": "2026-07",
    "note": "Labels are current-day GICS sectors applied uniformly across the whole backtest window. See data/README.md for why this is a known simplification."
  },
  "sector_cap_treatment_values": {
    "constituent": "Weight counts in full toward its declared sector's cap.",
    "diversified": "Broad multi-sector equity exposure with no single sector attribution. Exempt from sector caps; counts toward total equity exposure.",
    "non_equity": "Fixed income or commodity exposure. Exempt from sector caps and from total equity exposure."
  },
