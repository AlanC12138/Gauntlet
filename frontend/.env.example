# Where the FastAPI backend is served. Must be an origin listed in the API's
# `cors_origins` counterpart — see GAUNTLET_CORS_ORIGINS.
VITE_API_BASE=http://localhost:8000

# Clerk publishable key. Safe to expose — anything with a VITE_ prefix is
# compiled into the browser bundle, so this is public by construction. The
# matching SECRET key belongs in the repo-root .env and must never be given a
# VITE_ prefix. Leave unset to run with auth disabled.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
